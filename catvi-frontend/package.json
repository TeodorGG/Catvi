{
  "name": "catvi-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib e2e *.js *.mjs",
    "deploy": "npm ci --omit=dev && npm run build && rm -rf .next/cache && mkdir -p tmp && touch tmp/restart.txt"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8"
  }
}
