PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Generate with: openssl rand -hex 48
JWT_SECRET=
# Empty = separate local research.db. PostgreSQL is REQUIRED in production.
DATABASE_URL=
# PostgreSQL example: postgres://catvi:password@127.0.0.1:5432/catvi
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only set MD after physically deploying the measurement server in Moldova.
SERVER_ID=local-development
SERVER_NAME=Server de dezvoltare
SERVER_COUNTRY=LOCAL
# Set to 1 only behind the single trusted private reverse proxy.
TRUST_PROXY=0
